<UserControl x:Class="FinanceTracker.View.IncomeView.IncomeViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinanceTracker.View.IncomeView"
             mc:Ignorable="d" 
             d:DesignHeight="378" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#1A1A1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="378"/>
                <RowDefinition Height="86"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.66*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
            

            <Grid Grid.Row="1">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" 
       FontSize="27" Foreground="#1F4726" Margin="0, 12, 0, 0">
YOUR INCOMES <LineBreak/> THIS MONTH
                </TextBlock>
            </Grid>

            <Grid Grid.Row="2" Width="Auto">
                <ListBox ItemsSource="{Binding Incomes}" Width="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Gray" CornerRadius="8" Padding="20, 15" Margin="5"
                                    BorderThickness="1" Width="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2.5"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" Margin="10, 0"/>
                                    <Button Grid.Column="2" Content="Add" Command="{Binding AddCommand}" Cursor="Hand" Margin="10, 0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LastEdited, StringFormat={}{dd:MM:yyy HH:mm}}"  Margin="10, 0"/>
                                    <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveCommand}" Cursor="Hand" Margin="10, 0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
        </Grid>
    </ScrollViewer>
</UserControl>
