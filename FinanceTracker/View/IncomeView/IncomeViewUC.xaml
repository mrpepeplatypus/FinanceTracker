<UserControl x:Class="FinanceTracker.View.IncomeView.IncomeViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:FinanceTracker.View.IncomeView"
             mc:Ignorable="d" 
             d:DesignHeight="378" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#1A1A1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="378"/> <!-- Space for diagrams, summaries (Row 0) -->
                <RowDefinition Height="86"/> <!-- Space for section name (Row 1) -->
                <RowDefinition Height="40"/> <!-- Space for add button (entire list) (Row 2) -->
                <RowDefinition Height="320"/> <!-- Space for Income Lists (Rowe 3) -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.66*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Space for diagram (LiveChat) Library -->
                <Grid Grid.Column="0">
                    <lvc:PieChart Series="{Binding PieChartIncome}" 
                                  Margin="20"/>
                </Grid>
                
                <!-- Space for summaries -->
                <Grid Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding Incomes}" VerticalAlignment="Center" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5, 20, 0, 5" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" >
                                    <Rectangle Width="16" 
                                        Height="16" 
                                        Fill="{Binding Color}" 
                                        Margin="0,0,10,0" 
                                        RadiusX="2" 
                                        RadiusY="2" />

                                        <TextBlock Text="{Binding Name}" 
                                        VerticalAlignment="Center" 
                                        FontSize="15"
                                        Foreground="White"
                                                   />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        
                </Grid>

            </Grid>
            

            <Grid Grid.Row="1">
                <TextBlock HorizontalAlignment="Center" 
                           VerticalAlignment="Top" 
                           TextAlignment="Center" 
                           FontSize="27" 
                           Foreground="#1F4726" 
                           Margin="0, 12, 0, 0">
YOUR INCOMES <LineBreak/> THIS MONTH
                </TextBlock>
            </Grid>

            <Grid Grid.Row="2">
                <Button Content="+"
                        Command="{Binding AddCommand}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="10, 0" Padding="20, 10"
                        Background="#1F4726" Foreground="White" BorderThickness="0" Cursor="Hand">
                </Button>
            </Grid>
            
            <!-- INCOME LIST -->
            <Grid Grid.Row="3" Width="Auto">
                <ListBox ItemsSource="{Binding Incomes}" 
                         Width="Auto"
                         HorizontalAlignment="Stretch">
                        <!-- SPREADING A LIST TO ENTIRE ROW-->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0, 3"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#242424"
                                    CornerRadius="10"
                                    Padding="20, 15"
                                    Margin="10, 6"
                                    BorderBrush="#333333"
                                    Width="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                        <!-- NAME -->
                                    <TextBox Grid.Column="0" 
                                               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                               Background="#242424"
                                               VerticalAlignment="Center" 
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="#E0E0E0" />
                                    <!-- EARNINGS, VALUE -->
                                    <TextBox Grid.Column="1" 
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                Background="#242424"
                                                VerticalAlignment="Center" 
                                                FontSize="16" 
                                                FontWeight="Bold" 
                                                Foreground="#4CAF50"/>
                                    <!-- ADDING BUTTON -->
                                    <Button Grid.Column="2" 
                                            Content="Add" 
                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            Cursor="Hand"
                                            Margin="15,0,5,0" 
                                            Padding="15,6" 
                                            Background="#1F4726" 
                                            Foreground="White" 
                                            BorderThickness="0"/>
                                    <!-- DATE WITH A HOUR -->
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding LastEdited, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}"
                                               VerticalAlignment="Center" 
                                               FontSize="12" 
                                               Foreground="#888888"/>
                                    <!-- REMOVE BUTTON -->
                                    <Button Grid.Column="4" 
                                            Content="Remove" 
                                            Command="{Binding DataContext.RemoveCommand, 
                                            RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Margin="5,0,0,0" 
                                            Padding="15,6" 
                                            Background="#4A1E1E" 
                                            Foreground="#FF8888" 
                                            BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
        </Grid>
    </ScrollViewer>
</UserControl>
