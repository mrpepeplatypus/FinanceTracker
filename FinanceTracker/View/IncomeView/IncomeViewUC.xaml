<UserControl x:Class="FinanceTracker.View.IncomeView.IncomeViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinanceTracker.View.IncomeView"
             mc:Ignorable="d" 
             d:DesignHeight="378" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#1A1A1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="323"/>
                <RowDefinition Height="378"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="YOUR INCOMES" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Foreground="#193820" Margin="10"/>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.66*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
