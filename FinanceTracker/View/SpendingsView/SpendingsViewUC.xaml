<UserControl x:Class="FinanceTracker.View.SpendingsView.SpendingsViewUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinanceTracker.View.SpendingsView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="378"/> <!-- 0 - Space for PieChart and summaries -->
            <RowDefinition Height="86"/> <!-- 1 - Section name -->
            <RowDefinition Height="40"/> <!-- 2 - Adding entire list -->
            <RowDefinition Height="320"/> <!-- 3 - Space for lists -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- PieChart -->
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock HorizontalAlignment="Center" 
                           VerticalAlignment="Top" 
                           TextAlignment="Center" 
                           FontSize="27" 
                           Foreground="#1F4726" 
                           Margin="0, 12, 0, 0">
                YOUR INCOMES <LineBreak/> THIS MONTH
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2">
            <!--  -->
        </Grid>

        <Grid Grid.Row="3">
            <!-- List -->
            <ListBox>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="1"/>

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
