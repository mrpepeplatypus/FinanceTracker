<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceTracker"
        xmlns:TitleBarView="clr-namespace:FinanceTracker.View.TitleBar"
        xmlns:MenuBar="clr-namespace:FinanceTracker.View.TitleBar.MenuBar"
        mc:Ignorable="d" WindowStyle="None"
        Title="MainWindow" Height="450" Width="800"> 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="37"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top">
            <TitleBarView:TitleBarView/>
        </Grid>

        <Grid Grid.Row="1">
            <MenuBar:MenuBar/>
        </Grid>

        <Grid Grid.Row="2" Background="#1A1A1A"></Grid>
    </Grid>
</Window>
